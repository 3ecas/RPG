{
  "name": "rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pixel-art browser RPG: a single-player idle game growing into a small RuneScape-like MMO.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "tsx watch src/server/main.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node dist-server/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
